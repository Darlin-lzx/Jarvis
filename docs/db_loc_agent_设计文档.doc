</table>

<!-- ===== 14 设计决策 ===== -->
<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:30px 0 12px 0;">
  <tr><td style="background:#2b579a;border-radius:4px;padding:7px 16px;">
    <p style="margin:0;color:#ffffff;font-size:14pt;font-weight:bold;">14&nbsp;&nbsp;关键设计决策与安全边界</p></td></tr>
</table>
<h3 style="font-size:11.5pt;color:#173a6d;margin:8px 0 4px 0;">设计决策</h3>
<ul style="font-size:10.5pt;">
  <li><b>AgentState 显式字段</b>：LangGraph 会丢弃未定义键，skill_calls / agent_calls 必须先声明</li>
  <li><b>低置信度不自由发挥</b>：意图置信度 &lt;0.5 一律回退知识库问答</li>
  <li><b>工具统一分发</b>：_dispatch_tool 集成主图与子 Agent，避免双份逻辑</li>
  <li><b>只读数据源</b>：connect() 统一回滚 + 行数/单格上限，防巨量返回</li>
  <li><b>两级能力按服务注入</b>：ops/gov 为可选依赖，注入才暴露工具（低耦合、可测试）</li>
  <li><b>消息正文落库</b>：SSE 起止写 messages，实现会话历史回看（配合 trace 步骤）</li>
</ul>
<h3 style="font-size:11.5pt;color:#173a6d;margin:8px 0 4px 0;">安全边界</h3>
<ul style="font-size:10.5pt;">
  <li>SQL 只读（关键词黑名单 + 只读连接 + 统一回滚）</li>
  <li>脚本沙箱（内存 / 超时 / 危险模块 / 环境白名单）</li>
  <li>网关鉴权 + 限流 + 全量审计；上传文件名清洗（防路径穿越）+ 大小限制</li>
</ul>

<!-- ===== 15 运行 ===== -->
<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:30px 0 12px 0;">
  <tr><td style="background:#2b579a;border-radius:4px;padding:7px 16px;">
    <p style="margin:0;color:#ffffff;font-size:14pt;font-weight:bold;">15&nbsp;&nbsp;运行方式</p></td></tr>
</table>
<pre style="background:#0f1c30;color:#cdd9ea;border-radius:6px;padding:14px 16px;line-height:1.6;">
cd db_loc_agent
.venv/bin/python -m uvicorn db_loc_agent.app:create_app --factory \
    --host 0.0.0.0 --port 5010        # 启动后端

open http://localhost:5010/           # 浏览器访问
.venv/bin/python -m pytest tests/ -q # 运行 70 个测试
</pre>

<!-- ===== 附录 ===== -->
<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:30px 0 12px 0;">
  <tr><td style="background:#5a7cb0;border-radius:4px;padding:7px 16px;">
    <p style="margin:0;color:#ffffff;font-size:12.5pt;font-weight:bold;">附录 · 服务装配关系（create_app）</p></td></tr>
</table>
<pre style="background:#f4f8fd;border:1px solid #c9d8ec;border-radius:6px;padding:12px 14px;line-height:1.7;">
db = Database(db_path)              # SQLite + 建表 + agents 迁移
prompts   = PromptService(db)
skills    = SkillService(db, skills_dir)
artifacts = ArtifactService(db, artifact_root)
agents_svc= AgentService(db)
db_tools  = DbTools(db)             # + audit 审计回调 + obs_query 慢查询回调
kg        = KnowledgeGraph(db)
gov       = GovService(db, db_tools, kg)     # 第三级治理
ops       = OpsService(db, db_tools)         # 第二级运维
rag       = RAGStore(db, chroma_dir, kb_collection, embed_fn)
graph     = build_graph(llm, rag, prompts, artifacts, skills, cfg,
                        agents_svc, db_tools, kg, ops=ops, gov=gov)
gateway   = SecurityGateway(api_key, rate_limit, security_log)  # 中间件
</pre>

